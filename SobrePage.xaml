<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel_Agenda13.Pages.SobrePage"
             Title="Sobre"
             BackgroundColor="{StaticResource PageBackground}">
    <VerticalStackLayout Padding="24" Spacing="22" VerticalOptions="Center">
        <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                Padding="26" StrokeShape="RoundRectangle 24">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="APP HOTEL" FontSize="14" CharacterSpacing="3"
                       TextColor="#E6B566" FontAttributes="Bold" />
                <Label Text="Sobre o projeto" FontSize="27" TextColor="White"
                       FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label Text="Uma aplicação desenvolvida para praticar conceitos de interface gráfica no .NET MAUI."
                       TextColor="#E4F0EF" FontSize="14" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
        <Border BackgroundColor="White" Stroke="#E4EAE8" StrokeThickness="1"
                Padding="22" StrokeShape="RoundRectangle 18">
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="DESENVOLVEDOR" FontSize="11" TextColor="#71817E"
                           FontAttributes="Bold" CharacterSpacing="1.5" />
                    <Label Text="Théo Henrique" FontSize="19" TextColor="{StaticResource TextDark}"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
                <BoxView HeightRequest="1" Color="#E8EEEC" />
                <VerticalStackLayout Spacing="4">
                    <Label Text="ANO DE DESENVOLVIMENTO" FontSize="11" TextColor="#71817E"
                           FontAttributes="Bold" CharacterSpacing="1.5" />
                    <Label Text="2026" FontSize="19" TextColor="{StaticResource TextDark}"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
                <BoxView HeightRequest="1" Color="#E8EEEC" />
                <VerticalStackLayout Spacing="4">
                    <Label Text="TECNOLOGIA" FontSize="11" TextColor="#71817E"
                           FontAttributes="Bold" CharacterSpacing="1.5" />
                    <Label Text="C# • .NET MAUI • XAML" FontSize="16"
                           TextColor="{StaticResource TextDark}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
        <Label Text="Agenda 13 — Programação Mobile I"
               FontSize="12" TextColor="#71817E" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
